{
  "expo": {
    "name": "Wind & Co.",
    "slug": "wind-and-co",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAF7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.windco.closet",
      "infoPlist": {
        "NSCameraUsageDescription": "Wind & Co needs camera access to photograph your clothing items and take selfies.",
        "NSPhotoLibraryUsageDescription": "Wind & Co needs photo library access to import clothing photos.",
        "NSLocationWhenInUseUsageDescription": "Wind & Co uses your location for weather-based outfit recommendations."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAFAF7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.windco.closet",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Wind & Co needs camera access to photograph clothing items."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Wind & Co needs photo library access to import clothing photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Wind & Co uses your location for weather-based outfit suggestions."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "86ba65b0-280e-4c5d-9fd9-b72ce1e7dd2f"
      }
    },
    "owner": "arushg",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/86ba65b0-280e-4c5d-9fd9-b72ce1e7dd2f"
    }
  }
}
